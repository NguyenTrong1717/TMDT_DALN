{
  "name": "react-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"VITE,RAG\" -c \"cyan.bold,magenta.bold\" \"npm run dev:vite\" \"npm run rag\"",
    "dev:all": "concurrently -n \"VITE,SERVER,RAG\" -c \"cyan.bold,green.bold,magenta.bold\" \"npm run dev:vite\" \"npm run server\" \"npm run rag\"",
    "dev:vite": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server.mjs",
    "server:mongo": "node --env-file-if-exists=.env server_mongodb.mjs",
    "migrate:mongo": "node --env-file-if-exists=.env scripts/migrate_to_mongodb.mjs",
    "test:vnpay": "node --test --experimental-test-isolation=none tests/vnpay.test.mjs tests/checkout-api.test.mjs",
    "rag": "rag_service\\.venv\\Scripts\\python -m uvicorn rag_service.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir rag_service"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "lucide-react": "^1.23.0",
    "mongodb": "^7.6.0",
    "nodemon": "^3.1.14",
    "nprogress": "^0.2.0",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-paginate": "^8.3.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "json-server": "^0.17.4",
    "prettier": "^3.8.4",
    "vite": "^8.0.12"
  }
}
