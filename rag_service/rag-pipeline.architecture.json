  "cards": [
    {
      "dot": "cyan",
      "title": "Tầng Dữ Liệu & Vector (Indexing)",
      "items": [
        "Entity-based Chunking bảo toàn nguyên vẹn ngữ cảnh từng sản phẩm thay vì cắt theo số ký tự.",
        "Mô hình Local AI FastEmbed ONNX tạo vector ngữ nghĩa 384 chiều chạy offline siêu tốc (10-20ms).",
        "Fingerprint Cache trong RAM giúp loại bỏ hoàn toàn việc tính toán vector trùng lặp."
      ]
    },
    {
      "dot": "emerald",
      "title": "Tầng Truy Xuất & Xếp Hạng (Retrieval & Reranking)",
      "items": [
        "Cosine Similarity đo khoảng cách góc giữa câu hỏi và tri thức dựa trên vector L2 chuẩn hóa.",
        "Regex Parser bóc tách ngân sách tối đa (dưới 15tr) và ngân sách mục tiêu (tầm 20tr).",
        "Metadata Reranker thưởng điểm cho sản phẩm đúng danh mục và đúng tầm giá khách tìm."
      ]
    },
    {
      "dot": "rose",
      "title": "Tầng Bảo Mật & Sinh Phản Hồi (Generation & Guardrails)",
      "items": [
        "3 lớp bảo vệ độc lập: Chặn rò rỉ PII, chặn Prompt Injection (DAN/Jailbreak) và lọc Off-topic.",
        "Google Gemini 3.5 Flash Lite sinh câu trả lời tự nhiên, ngắn gọn và bám sát 100% dữ liệu cửa hàng.",
        "Cơ chế Smart Local Fallback tự động phản hồi theo mẫu nếu mất kết nối mạng hoặc lỗi API."
      ]
    }
